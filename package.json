{
  "name": "openclaw-channel-deltachat",
  "version": "0.1.7",
  "description": "OpenClaw channel plugin for Delta Chat",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "deltachat",
    "delta-chat",
    "chatmail",
    "autocrypt",
    "email",
    "messaging"
  ],
  "author": "Tomas Kracmar <tomas.kracmar@cqre.net>",
  "repository": {
    "type": "git",
    "url": "https://git.ocean/avedelphina/deltaclaw.git"
  },
  "bugs": {
    "url": "https://git.ocean/avedelphina/deltaclaw/issues"
  },
  "homepage": "https://git.ocean/avedelphina/deltaclaw#readme",
  "engines": {
    "node": ">=20"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "dependencies": {
    "@deltachat/jsonrpc-client": "^2.47.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
